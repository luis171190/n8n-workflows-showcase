# ============================================================================
# e-commerce-product-search-bot — variables de entorno (template)
# Copiar a .env.local. Esta es la fuente de verdad: el workflow lee $env.<KEY>
# ============================================================================

# Tienda WooCommerce (la demo apunta a un dominio ficticio — reemplazá con el tuyo)
# Sin trailing slash. El workflow llama a {STORE_BASE_URL}/wp-json/wc/store/products
STORE_BASE_URL=https://demo.acme-store.example.com

# LLM provider — switch en runtime. Valores: openai | anthropic
LLM_PROVIDER=openai

# OpenAI (si LLM_PROVIDER=openai)
# Modelo configurado en el JSON: gpt-4o-mini (cambiable en el nodo "OpenAI")
OPENAI_API_KEY=sk-...

# Anthropic (si LLM_PROVIDER=anthropic)
# Modelo configurado: claude-sonnet-4-5 (cambiable en el nodo "Anthropic")
# Para latencia baja / costo bajo: claude-haiku-4-5-20251001
ANTHROPIC_API_KEY=sk-ant-...

# Idioma de las respuestas generadas por el bot. Valores: en | es
# Default: en. Afecta tanto el system prompt del LLM como los textos de fallback
# que produce el post-procesador anti-hallucination cuando sanitiza la respuesta.
BOT_LANG=en

# Postgres telemetry — la credencial Postgres se configura DENTRO de n8n
# (Settings -> Credentials -> Postgres). El workflow referencia el credential
# por nombre "bot_telemetry_db". Schema SQL en ./sql/001_telemetry_schema.sql.
# Estos valores son solo referencia para que sepas qué cargar en n8n:
PGHOST=localhost
PGPORT=5432
PGDATABASE=bot_telemetry
PGUSER=bot_user
PGPASSWORD=
