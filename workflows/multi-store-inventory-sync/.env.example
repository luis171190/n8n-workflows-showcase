# ============================================================================
# multi-store-inventory-sync — variables de entorno (template)
# ============================================================================

# --- WooCommerce REST API ---
WOO_BASE_URL=https://acme-store.example.com
# Las credenciales de WooCommerce se configuran DENTRO de n8n como HTTP Basic Auth:
# Settings -> Credentials -> HTTP Basic Auth
# Username = consumer_key (ck_...), Password = consumer_secret (cs_...)
# Nombre exacto esperado: wc_consumer_key_secret

# --- Odoo (JSON-RPC) ---
ODOO_BASE_URL=https://acme-erp.example.com
ODOO_DATABASE=acme_production
# UID se obtiene una sola vez via /web/session/authenticate y se cachea aca.
# En producción, un workflow auxiliar refresca el UID si Odoo lo invalida.
ODOO_UID=2
ODOO_PASSWORD=

# --- Reconciliation ---
# Si true, el cron diario aplica auto-fix Odoo→WC para drift de stock.
# Recomendado: false durante onboarding (revisás manualmente), true cuando
# tengas confianza. Default: false.
RECONCILIATION_AUTO_FIX=false

# --- Postgres ---
# Credencial Postgres dentro de n8n con nombre: inventory_db
# Schema en ./sql/001_inventory_sync_schema.sql
PGHOST=localhost
PGPORT=5432
PGDATABASE=inventory_sync
PGUSER=sync_user
PGPASSWORD=
