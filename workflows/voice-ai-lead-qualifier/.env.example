# Voice AI Lead Qualifier — Environment Variables
# Copy to .env.local and fill in real values. NEVER commit .env.local.

# ─── Retell AI ────────────────────────────────────────────
RETELL_API_URL=https://api.retellai.com
RETELL_API_KEY=key_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
RETELL_AGENT_ID=agent_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
RETELL_FROM_NUMBER=+1XXXXXXXXXX          # Your Retell-provisioned outbound number

# ─── LLM Provider ─────────────────────────────────────────
# 'openai' or 'anthropic' — controls which branch of the Switch node runs
LLM_PROVIDER=openai

OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_MODEL=gpt-4o-mini

ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ANTHROPIC_MODEL=claude-sonnet-4-5

# ─── Compliance ────────────────────────────────────────────
# IANA timezone name for the target prospect's timezone
# (used by Working Hours Compliance node)
BUSINESS_TIMEZONE=America/New_York
WORKING_HOURS_START=9                   # 09:00 local
WORKING_HOURS_END=18                    # 18:00 local (exclusive)

# ─── Google Calendar (hot lead → schedule meeting) ─────────
GOOGLE_CALENDAR_ID=your-calendar-id@group.calendar.google.com

# ─── Airtable CRM (hot lead → create deal) ────────────────
AIRTABLE_BASE_ID=appXXXXXXXXXXXXXX
AIRTABLE_API_KEY=patXXXXXXXXXXXXXX.XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
AIRTABLE_TABLE_DEALS=Deals

# ─── PostgreSQL ────────────────────────────────────────────
# In n8n, configure a 'postgres' credential named 'lead_qualifier_db'
# and reference it in all Postgres nodes. These vars are for local psql only.
PGHOST=localhost
PGPORT=5432
PGDATABASE=lead_qualifier
PGUSER=postgres
PGPASSWORD=postgres
