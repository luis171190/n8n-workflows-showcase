# ============================================================================
# whatsapp-booking-system — variables de entorno (template)
# Copiar a .env.local y exponer al runtime de n8n.
# ============================================================================

# --- Business identity ---
# UUID v4 que identifica el comercio. Cambiá si querés multi-tenant; aca lo dejamos
# fijo para la demo de ACME Studio (matchea el seed del SQL).
BUSINESS_ID=00000000-0000-0000-0000-000000000001

# Zona horaria del negocio. Storage es UTC siempre, pero las fechas que el bot
# muestra al usuario y el timeZone del evento de Calendar usan esta TZ.
BUSINESS_TIMEZONE=America/Argentina/Buenos_Aires

# --- WhatsApp via Evolution API ---
EVOLUTION_API_URL=https://your-evolution.example.com
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=acme-studio

# --- LLM provider (intercambiables) ---
LLM_PROVIDER=openai

# OpenAI (modelo configurado en JSON: gpt-4o-mini)
OPENAI_API_KEY=sk-...

# Anthropic (modelo configurado: claude-sonnet-4-5)
# Para baja latencia / costo bajo: claude-haiku-4-5-20251001
ANTHROPIC_API_KEY=sk-ant-...

# --- Idioma de respuestas (en | es) ---
BOT_LANG=en

# --- Google Calendar ---
# Calendario donde se crean los eventos. "primary" usa el calendario principal
# de la cuenta autenticada. Para multi-staff conviene un calendario dedicado.
GOOGLE_CALENDAR_ID=primary

# La credencial OAuth2 se configura DENTRO de n8n:
# Settings -> Credentials -> Google Calendar OAuth2 API
# Nombre exacto esperado: google_calendar_oauth

# --- Postgres ---
# La credencial Postgres se configura dentro de n8n con nombre: booking_db
# Schema en ./sql/001_booking_schema.sql
PGHOST=localhost
PGPORT=5432
PGDATABASE=booking
PGUSER=booking_user
PGPASSWORD=
